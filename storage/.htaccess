# A storage/ az importok átmeneti könyvtára és a naplóké – a webszerver kiszolgálja, ezért
# a benne landoló fájl SOHA nem futhat le. Ugyanaz a mélységi védelem, mint a kepek/-nél.

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(?i:php|phtml|phar|php[0-9]|pl|py|cgi|asp|aspx|jsp|shtml|htaccess)$">
    Require all denied
</FilesMatch>

Options -Indexes -ExecCGI

RemoveHandler .php .phtml .phar
AddType text/plain .php .phtml
